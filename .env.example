# Copy this to .env.local for local dev. On Vercel, add each of these under
# Project Settings -> Environment Variables instead (no file needed there —
# Vercel injects them as real process.env vars for both install and build).

# Neon Postgres connection string (used via @prisma/adapter-neon).
DATABASE_URL=

# Signs the admin/host session tokens issued by app/api/auth/login.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary — image/video uploads (Admin Panel "Фон зураг", CreateForm, etc).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# what3words Convert-to-Coordinates API — powers the location picker's
# what3words lookup in CreateForm. Optional: without it, that lookup shows a
# "W3W_API_KEY тохируулаагүй байна" message but the rest of the app is fine.
W3W_API_KEY=

# SMTP — sends real OTP login codes to email addresses (see lib/mailer.ts).
# Optional: without these, /api/auth/request-otp falls back to dev mode and
# hands the code straight back in the response instead of emailing it.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your
# address, SMTP_PASS=an App Password (not your regular password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset.
SMTP_FROM=
