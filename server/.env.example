# Postgres — matches docker-compose.yml. Change only if you point at a different DB.
DATABASE_URL="postgresql://bigbang:bigbang@localhost:5432/bigbang?schema=public"

# Long random string used to sign JWTs — generate your own for real use
# (e.g. `openssl rand -hex 32`), never reuse this placeholder in production.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Cloudinary — from your Cloudinary dashboard (console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

PORT=4000
CORS_ORIGIN="http://localhost:5173"
